# TRUSTVERIFY AI - Environment Variables
# Copy to .env.local to configure custom keys

PORT=3000
NODE_ENV=development

# Google Gemini API Key (Optional: system automatically falls back to local heuristic NLP if not provided)
GEMINI_API_KEY=

# Default Verification Thresholds
DEFAULT_AI_PROVIDER=gemini
DEFAULT_FACE_THRESHOLD=0.82
